<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0F"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إعدادات التصدير"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- الدقة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الدقة (Resolution)"
        android:textColor="#80FFFFFF"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/resolutionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:checkedButton="@+id/btn1080p">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1080p"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1080p"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2k"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2K"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4k"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4K"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- معدل الإطارات -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="معدل الإطارات (FPS)"
        android:textColor="#80FFFFFF"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/fpsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:checkedButton="@+id/btn30fps">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn30fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="30"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#FFFFFF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn60fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="60"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="#FFFFFF"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- زر البدء -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="بدء التصدير"
        app:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>
