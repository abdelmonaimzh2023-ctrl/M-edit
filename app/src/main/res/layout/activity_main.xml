<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0F">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center">

        <!-- فيديو -->
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:background="@drawable/glass_surface"/>

        <!-- صف الأزرار الأيقونية -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/button_glass_dark"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- اختيار فيديو -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickVideo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_video_library"
                app:iconSize="22dp"
                app:cornerRadius="22dp"
                app:iconGravity="textStart"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.IconButton"/>

            <!-- تشغيل -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_play"
                app:iconSize="22dp"
                app:cornerRadius="22dp"
                app:iconGravity="textStart"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.IconButton"/>

            <!-- إيقاف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_pause"
                app:iconSize="22dp"
                app:cornerRadius="22dp"
                app:iconGravity="textStart"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.Button.IconButton"/>

            <!-- تصدير -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport4K"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_export"
                app:iconSize="22dp"
                app:cornerRadius="22dp"
                app:iconGravity="textStart"
                style="@style/Widget.Material3.Button.IconButton"/>
        </LinearLayout>
    </LinearLayout>

    <!-- شاشة التحميل -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD0A0A0F"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#4CAF50"
            style="?android:attr/progressBarStyle"/>
    </LinearLayout>

</FrameLayout>
