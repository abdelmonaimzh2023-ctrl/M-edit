<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- تأثيرات خلفية -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_circle_1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="-40dp"/>

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_circle_2"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="-30dp"/>

    <!-- المحتوى الرئيسي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="40dp">

        <!-- إطار الشعار (Glass) -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/glass_circle"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/splashLogoIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"
                android:scaleType="fitCenter"/>

            <!-- طبقة الوميض -->
            <View
                android:id="@+id/logoGlow"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/glow_ring"
                android:visibility="invisible"/>
        </FrameLayout>

        <!-- اسم التطبيق -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M-edit"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.08"
            android:layout_marginTop="28dp"
            android:visibility="invisible"
            android:elevation="4dp"/>

        <!-- وصف -->
        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="محرر فيديو احترافي"
            android:textSize="14sp"
            android:textColor="#AAFFFFFF"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp"
            android:visibility="invisible"
            android:elevation="4dp"/>

        <!-- شريط تقدم -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginTop="36dp"
            android:progressTint="#E91E63"
            android:progressBackgroundTint="#33FFFFFF"
            android:visibility="invisible"
            android:elevation="4dp"/>
    </LinearLayout>

</RelativeLayout>
