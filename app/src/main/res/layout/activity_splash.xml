<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0F">

    <!-- تأثيرات خلفية خفيفة -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_circle_green"
        android:layout_gravity="center"
        android:layout_marginTop="-80dp"
        android:alpha="0.15"/>

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_circle_green"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="80dp"
        android:alpha="0.08"/>

    <!-- المحتوى -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:padding="40dp">

        <!-- إطار أيقونة التطبيق -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/glass_circle"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/splashLogoIcon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/icon"
                android:scaleType="fitCenter"
                android:clipToOutline="true"
                android:background="@drawable/splash_logo_bg_black"/>

            <View
                android:id="@+id/logoGlow"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/glow_ring_green"
                android:visibility="invisible"/>
        </FrameLayout>

        <!-- اسم التطبيق -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M-edit"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#F2FFFFFF"
            android:letterSpacing="0.08"
            android:layout_marginTop="24dp"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="محرر فيديو • 4K"
            android:textSize="13sp"
            android:textColor="#B3FFFFFF"
            android:letterSpacing="0.05"
            android:layout_marginTop="6dp"
            android:visibility="invisible"/>

        <!-- شريط تقدم -->
        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="2dp"
            android:layout_marginTop="32dp"
            android:progressTint="#4CAF50"
            android:progressBackgroundTint="#15FFFFFF"
            android:visibility="invisible"/>
    </LinearLayout>

</FrameLayout>
